---
// src/components/SidebarNav.astro
//
// Prerendered nav chrome. Every one of the deck's 64 states carries its own
// copy of this, rendered to static HTML at build time, so the controls are
// visible and correctly labelled before any JS runs.
//
// That is why there are no event handlers here. Behaviour — first/prev/next/
// last, the centre chip's click-to-toggle-mode and long-press-to-reset — lives
// in the single DeckControls island, which finds these buttons by their
// `data-deck-action` attribute and delegates from the deck root.

import { cn } from "@/lib/utils"
import type { ViewMode } from "@/lib/cookies"
import type { HTMLAttributes } from "astro/types"

interface Props {
  index: number
  total: number
  currentMode?: ViewMode
  class?: string
}

const { index, total, currentMode, class: className } = Astro.props

const ARROW_CLASS = `inline-flex items-center justify-center h-9 w-9 max-md:h-10 max-md:w-10 shrink-0 rounded-full cursor-pointer
  border border-neutral-200 text-neutral-700 shadow-sm transition-colors
  hover:!bg-[var(--accent)] hover:!border-[var(--accent)] hover:!text-white hover:shadow-md
  focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:ring-offset-1`

const CHEVRON_SVG: HTMLAttributes<"svg"> = {
  xmlns: "http://www.w3.org/2000/svg",
  class: "h-4 w-4",
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "2",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
  "aria-hidden": true,
}

// Lucide's chevrons-left, chevron-left, chevron-right and chevrons-right.
const ARROWS = [
  { action: "first", label: "First slide", title: "First", paths: ["m11 17-5-5 5-5", "m18 17-5-5 5-5"] },
  { action: "prev", label: "Previous slide", title: "Previous", paths: ["m15 18-6-6 6-6"] },
  { action: "next", label: "Next slide", title: "Next", paths: ["m9 18 6-6-6-6"] },
  { action: "last", label: "Last slide", title: "Last", paths: ["m6 17 5-5-5-5", "m13 17 5-5-5-5"] },
]
---

<div class={cn("w-full flex items-center justify-between", className)}>
  {
    ARROWS.slice(0, 2).map((a) => (
      <button type="button" data-deck-action={a.action} aria-label={a.label} title={a.title} class={ARROW_CLASS}>
        <svg {...CHEVRON_SVG}>{a.paths.map((d) => <path d={d} />)}</svg>
      </button>
    ))
  }

  {/* CENTER “chip” — looks like text, but is a button */}
  <button
    type="button"
    data-deck-action="mode"
    aria-label="Toggle view mode or reset on long press"
    title="Click: toggle fullscreen • Long-press: reset to first slide"
    class="mx-2 max-md:mx-0 px-3 max-md:px-2.5 h-9 max-md:h-10 rounded-full border border-neutral-300 bg-white/80 backdrop-blur
                   text-xs tracking-wide select-none whitespace-nowrap
                   [--tw-ring-offset-shadow:0_0_0_0_transparent] [--tw-ring-shadow:0_0_0_0_transparent]"
    >{index + 1} / {total} • <span data-deck-mode-label>{currentMode ?? "dataview"}</span></button
  >

  {
    ARROWS.slice(2).map((a) => (
      <button type="button" data-deck-action={a.action} aria-label={a.label} title={a.title} class={ARROW_CLASS}>
        <svg {...CHEVRON_SVG}>{a.paths.map((d) => <path d={d} />)}</svg>
      </button>
    ))
  }
</div>
