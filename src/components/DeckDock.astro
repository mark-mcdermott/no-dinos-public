---
// src/components/DeckDock.astro
//
// The floating nav dock, lifted out of the old Deck.tsx (where it was
// `FloatingNav`), and the info button that shows and hides it.
//
// Both are prerendered into every one of the 64 states rather than rendered by
// the island. That is deliberate: if the dock only appeared once React had
// hydrated, a screenshot taken in the window before hydration would be missing
// it, and the deck would look different depending on how fast JS arrived.
// Baked in, each state is a complete picture of the page on its own.
//
// One label does change without the slide changing — the view mode on a title
// slide, which renders the same in both modes — so it is wrapped in a span the
// island rewrites in place.
//
// The info button shares the dock's row but sits outside `data-deck-dock`, so
// it survives the dock being hidden: on a touch screen it is the only way to
// bring it back.

import { Icon } from "@/components/Icon"
import SidebarNav from "@/components/SidebarNav.astro"
import SidebarSignature from "@/components/SidebarSignature.astro"
import type { ViewMode } from "@/lib/cookies"

interface Props {
  index: number
  total: number
  mode: ViewMode
}

const { index, total, mode } = Astro.props
const tooltipId = `dock-tip-${index}-${mode}`
const KBD_CLASS = "font-sans font-semibold"
---

{/* One bottom row: the dock, then the info button that survives it being hidden */}
<div class="pointer-events-none fixed right-4 bottom-4 z-40 flex items-center gap-2 max-md:left-3 max-md:right-3 max-md:bottom-2">
  <div data-deck-dock class="relative max-md:flex-1 max-md:min-w-0">
    {/* The cover carries its own credit */}
    {
      index > 0 && (
        <SidebarSignature class="absolute bottom-full right-0 mb-2 !mt-0 whitespace-nowrap opacity-80" />
      )
    }
    <div
      class="pointer-events-auto rounded-2xl border border-neutral-200/80 bg-white/85 backdrop-blur-md shadow-md px-3 py-2 max-md:px-1.5 flex items-center gap-4"
    >
      <SidebarNav index={index} total={total} currentMode={mode} class="gap-4 max-md:gap-0" />
    </div>
  </div>

  <button
    type="button"
    data-deck-action="toggle-dock"
    aria-label="Show or hide navigation"
    aria-describedby={tooltipId}
    class="group pointer-events-auto relative shrink-0 grid place-items-center h-7 w-7 max-md:h-9 max-md:w-9 rounded-full cursor-pointer
           border border-neutral-200/80 bg-white/85 backdrop-blur-md text-neutral-600 shadow-sm transition-colors
           hover:text-[var(--accent)] hover:border-[var(--accent)]
           focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:ring-offset-1"
  >
    <Icon name="info" className="h-4 w-4" />
    <span
      id={tooltipId}
      role="tooltip"
      class="pointer-events-none absolute bottom-full right-0 mb-2 w-max rounded-lg bg-neutral-900/90 px-2.5 py-1.5
             text-left text-[11px] leading-5 text-white shadow-lg backdrop-blur
             opacity-0 translate-y-1 transition group-hover:opacity-100 group-hover:translate-y-0
             group-focus-visible:opacity-100 group-focus-visible:translate-y-0"
    >
      {
        index === 0 && (
          <Fragment>
            <kbd class={KBD_CLASS}>←</kbd> <kbd class={KBD_CLASS}>→</kbd> arrow keys move between slides<br />
          </Fragment>
        )
      }
      Show / hide navigation:
      <kbd class={KBD_CLASS}>⌃ D</kbd> on Mac · <kbd class={KBD_CLASS}>Ctrl + D</kbd> on Windows
    </span>
  </button>
</div>
